@page "/torrents/add"
@using System.Net
@using TransmissionManager.Api.Common.Dto.Torrents
@using TransmissionManager.Web.Components
@using TransmissionManager.Web.Constants
@using TransmissionManager.Web.Dto
@using TransmissionManager.Web.Forms
@using TransmissionManager.Web.Services
@inherits CommonComponentBase
@inject TransmissionManagerClient Client

<PageTitle>Add Torrent - Transmission Manager</PageTitle>

<div class="item-card">
    <h4 class="text-block">Add a torrent</h4>

    <div>
        <label for="sourceKind">Torrent source:</label>
        <select id="sourceKind"
                class="form-input"
                disabled="@IsBusy"
                @bind:get="_form.SourceKind"
                @bind:set="ChangeSourceKind">
            <option value="@TorrentSourceKind.WebPage">Web page</option>
            <option value="@TorrentSourceKind.JsonPointer">JSON API</option>
        </select>
    </div>

    <EditForm EditContext="_editContext" OnSubmit="AddTorrentAsync">
        <DataAnnotationsValidator />

        <div>
            <label for="sourceUri">@SourceUriLabel</label>
            <InputText id="sourceUri" class="form-input" disabled="@IsBusy" @bind-Value="_form.SourceUri" />
            <ValidationMessage For="@(() => _form.SourceUri)" />
        </div>

        <div>
            <label for="downloadDir">Download directory:</label>
            <InputText id="downloadDir" class="form-input" disabled="@IsBusy" @bind-Value="_form.DownloadDir" />
            <ValidationMessage For="@(() => _form.DownloadDir)" />
        </div>

        <div>
            <label for="magnetRegexPattern">@MagnetRegexPatternLabel</label>
            <InputText id="magnetRegexPattern" class="form-input" disabled="@IsBusy" @bind-Value="_form.MagnetRegexPattern" />
            <ValidationMessage For="@(() => _form.MagnetRegexPattern)" />
        </div>

        <div>
            <label for="jsonValueFormat">Magnet link format (JSON API only, optional):</label>
            <InputText id="jsonValueFormat"
                       class="form-input"
                       disabled="@(IsBusy || _form.IsWebPageSource)"
                       @bind-Value="_form.JsonValueFormat" />
            <ValidationMessage For="@(() => _form.JsonValueFormat)" />
        </div>

        <div>
            <label for="cron">
                Refresh schedule <a target="_blank" href="https://crontab.guru/#0_9,19_*_*_*">cron</a> (optional):
            </label>
            <InputText id="cron" class="form-input" disabled="@IsBusy" @bind-Value="_form.Cron" />
            <ValidationMessage For="@(() => _form.Cron)" />
        </div>

        <button class="form-button clickable" type="submit" disabled="@IsBusy">Add torrent</button>
    </EditForm>

    @if (!string.IsNullOrEmpty(Message))
    {
        if (_newTorrentId > -1)
        {
            <p class="text-block">@Message<a href="@($"{PageAddresses.Torrents}/{_newTorrentId}")">go to details</a></p>
        }
        else
        {
            <p class="text-block">@Message</p>
        }
    }
</div>

@code {
    private readonly AddTorrentForm _form = new();

    private EditContext _editContext = null!;

    private long _newTorrentId = -1;

    private string SourceUriLabel => _form.IsWebPageSource
        ? "Torrent webpage:"
        : "JSON API address with pointer:";

    private string MagnetRegexPatternLabel => _form.IsWebPageSource
        ? "Magnet link regex (optional):"
        : "JSON value regex (optional):";

    private protected override string BusyMessage => "Adding torrent...";

    protected override void OnInitialized() => _editContext = new(_form);

    /// <remarks>
    /// The TransmissionResult is worth stating on this page: an Add that conflicts locally may
    /// already have handed the magnet to Transmission, and the user has to know that happened.
    /// </remarks>
    private protected override string GetProblemDetailsMessage(
        ApiProblemDetails? problemDetails,
        HttpStatusCode? statusCode)
    {
        var message = base.GetProblemDetailsMessage(problemDetails, statusCode);
        return problemDetails?.TransmissionResult is { } transmissionResult
            ? $"{message} Transmission result: {transmissionResult}."
            : message;
    }

    /// <remarks>
    /// The select sits outside the <see cref="EditForm"/> on purpose: replacing the
    /// <see cref="EditContext"/> is what clears the other kind's validation messages, and
    /// <see cref="EditForm"/> keys its render region on that context, so every descendant is torn
    /// down and rebuilt - which would destroy the select mid-change and drop keyboard focus to the
    /// document. Only a tampered value can parse to an undefined kind, so it is refused rather than
    /// looked up.
    /// </remarks>
    private void ChangeSourceKind(TorrentSourceKind sourceKind)
    {
        if (!Enum.IsDefined(sourceKind) || !_form.SwitchSourceKind(sourceKind))
            return;

        _editContext = new(_form);
        _newTorrentId = -1;
        Message = string.Empty;
    }

    public async Task AddTorrentAsync(EditContext editContext)
    {
        if (IsBusy)
            return;

        _newTorrentId = -1;
        Message = string.Empty;

        _form.Normalize();
        if (!editContext.Validate())
            return;

        var request = _form.CreateRequest();
        var result = await CallNetworkService(
            (Client, request),
            static args => args.Client.AddTorrentAsync(args.request));

        if (result.Status is ApiResultStatus.Success)
        {
            Message = "Torrent added, ";
            _newTorrentId = result.Value!.TorrentDto.Id;
        }
    }
}
