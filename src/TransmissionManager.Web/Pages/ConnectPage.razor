@page "/connect"
@using System.ComponentModel.DataAnnotations
@using System.Net
@using TransmissionManager.Web.Components
@using TransmissionManager.Web.Dto
@using TransmissionManager.Web.Services
@using TransmissionManager.Web.Validation
@inherits CommonComponentBase
@inject ApiAddressService ApiAddressService

<PageTitle>Connect - Transmission Manager</PageTitle>

<div class="item-card">
    <h4 class="text-block">Connect to Transmission Manager</h4>

    <EditForm Model="this" OnValidSubmit="ConnectAsync">
        <DataAnnotationsValidator />

        <div>
            <label for="address">Address:</label>
            <InputText id="address" type="search" role="textbox" class="form-input" disabled="@IsBusy" @bind-Value="Address" />
            <ValidationMessage For="@(() => Address)" />
        </div>

        <button class="form-button clickable" type="submit" disabled="@IsBusy">Connect</button>
    </EditForm>

    @if (!string.IsNullOrEmpty(Message))
    {
        <p role="alert" class="text-block">@Message</p>
    }
</div>

@code {
    private protected override string BusyMessage => "Connecting...";

    [Required, ApiAddress]
    public string Address { get; private set; } = string.Empty;

    protected override void OnInitialized() => Address = ApiAddressService.BaseAddress.AbsoluteUri;

    private protected override string GetOperationCanceledMessage(OperationCanceledException exception) =>
        $"Connection attempt timed out. Please check the {nameof(Address)}.";

    /// <remarks>
    /// An answer carrying no problem details did not come from this API - a wrong port reaching some
    /// other application, or a proxy answering for it - so the address is what the user has to
    /// check. An answer that did come from this API already says what is wrong.
    /// </remarks>
    private protected override string GetProblemDetailsMessage(
        ApiProblemDetails? problemDetails,
        HttpStatusCode? statusCode)
    {
        var message = base.GetProblemDetailsMessage(problemDetails, statusCode);
        return problemDetails is null
            ? $"{message} Please check the {nameof(Address)}."
            : message;
    }

    private async Task ConnectAsync()
    {
        if (IsBusy || !ApiAddressUtils.TryCreate(Address, out var baseAddress))
            return;

        var result = await CallNetworkService(
            (ApiAddressService, baseAddress),
            static args => args.ApiAddressService.ConnectAsync(args.baseAddress));

        if (result is { Status: ApiResultStatus.Success, Value: { } connection })
        {
            Address = baseAddress.AbsoluteUri;
            Message = connection.IsAddressSaved
                ? $"Connected to {baseAddress} | Version: {connection.Version}"
                : $"Connected to {baseAddress} | Version: {connection.Version} | The address cannot be saved.";
        }
    }
}
