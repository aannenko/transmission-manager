@page "/torrents/{Id:long}"
@using System.ComponentModel.DataAnnotations
@using System.Net
@using TransmissionManager.Api.Common.Attributes
@using TransmissionManager.Api.Common.Dto.Torrents
@using TransmissionManager.Api.Common.Validation
@using TransmissionManager.Web.Components
@using TransmissionManager.Web.Dto
@using TransmissionManager.Web.Extensions
@using TransmissionManager.Web.Services
@inherits CommonComponentBase
@implements IValidatableObject
@inject TransmissionManagerClient Client

<PageTitle>@Name - Transmission Manager</PageTitle>

<div class="item-card">
    <h4 class="text-block">Torrent details</h4>

    <p class="text-block">ID: @Id</p>

    <div>
        <span>Name:</span>
        <div class="form-input">@Name</div>
    </div>

    <div>
        <span>@SourceUriLabel</span>
        <div class="form-input">
            <a href="@SourceUri" target="_blank">@SourceUri</a>
        </div>
    </div>

    <div>
        <span>Hash:</span>
        <div class="form-input">@HashString</div>
    </div>

    <div>
        <span>Refreshed on:</span>
        <div class="form-input">@(RefreshDate?.ToServerTimeString() ?? string.Empty)</div>
    </div>

    <EditForm Model="this" OnValidSubmit="UpdateTorrentAsync">
        <DataAnnotationsValidator />

        <div>
            <label for="downloadDir">Download directory:</label>
            <InputText id="downloadDir" class="form-input" disabled="@AreControlsDisabled" @bind-Value="DownloadDir" />
            <ValidationMessage For="@(() => DownloadDir)" />
        </div>

        <div>
            <label for="magnetRegexPattern">@MagnetRegexPatternLabel</label>
            <InputText id="magnetRegexPattern" class="form-input" disabled="@AreControlsDisabled" @bind-Value="MagnetRegexPattern" />
            <ValidationMessage For="@(() => MagnetRegexPattern)" />
        </div>

        @if (!IsWebPageSource)
        {
            <div>
                <label for="jsonValueFormat">Magnet link format (optional):</label>
                <InputText id="jsonValueFormat" class="form-input" disabled="@AreControlsDisabled" @bind-Value="JsonValueFormat" />
                <ValidationMessage For="@(() => JsonValueFormat)" />
            </div>
        }

        <div>
            <label for="cron">
                Refresh schedule <a target="_blank" href="https://crontab.guru/#0_9,19_*_*_*">cron</a> (optional):
            </label>
            <InputText id="cron" class="form-input" disabled="@AreControlsDisabled" @bind-Value="Cron" />
            <ValidationMessage For="@(() => Cron)" />
        </div>

        <button class="form-button clickable" type="submit" disabled="@AreControlsDisabled">Update torrent</button>
    </EditForm>

    <button class="form-button clickable" @onclick="RefreshTorrentAsync" disabled="@AreControlsDisabled">Refresh torrent</button>

    <button class="form-button clickable" @onclick="DeleteLocalTorrentAsync" disabled="@AreControlsDisabled">Remove torrent locally</button>

    <button class="form-button clickable" @onclick="DeleteLocalAndTransmissionTorrentAsync" disabled="@AreControlsDisabled">Remove locally and from Transmission</button>

    <button class="form-button clickable" @onclick="DeleteTorrentAndDataAsync" disabled="@AreControlsDisabled">Remove locally, from Transmission, delete data</button>

    @if (!string.IsNullOrEmpty(Message))
    {
        <p class="text-block">@Message</p>
    }
</div>

@code {
    enum Operation
    {
        Load,
        Update,
        Refresh,
        DeleteRecord,
        DeleteTransmission,
        DeleteData
    }

    private Operation _operation = Operation.Load;

    private TorrentDto? _currentTorrent;

    [Parameter]
    public long Id { get; set; }

    [Required(ErrorMessage = "Value required.")]
    public string DownloadDir { get; private set; } = string.Empty;

    [MaxLength(TorrentSourceRules.MaxPatternLength)]
    public string MagnetRegexPattern { get; private set; } = string.Empty;

    [JsonValueFormat]
    public string JsonValueFormat { get; private set; } = string.Empty;

    [Cron]
    public string Cron { get; private set; } = string.Empty;

    private string Name => _currentTorrent?.Name ?? string.Empty;

    private string SourceUri => _currentTorrent?.SourceUri.OriginalString ?? string.Empty;

    private string HashString => _currentTorrent?.HashString ?? string.Empty;

    private DateTimeOffset? RefreshDate => _currentTorrent?.RefreshDate;

    private string SourceUriLabel => IsWebPageSource
        ? "Torrent webpage:"
        : "JSON API address with pointer:";

    private bool IsWebPageSource => SourceKind is not TorrentSourceKind.JsonPointer;

    private TorrentSourceKind SourceKind => _currentTorrent?.SourceKind ?? TorrentSourceKind.WebPage;

    private string MagnetRegexPatternLabel => IsWebPageSource
        ? "Magnet link regex (optional):"
        : "JSON value regex (optional):";

    /// <summary>
    /// Checks the pattern and the format against the rules of this torrent's source kind.
    /// </summary>
    /// <param name="validationContext">The context this validation runs in.</param>
    /// <returns>What is wrong with the pattern or the format, if anything.</returns>
    /// <remarks>
    /// A web page pattern has to find a magnet link, a JSON one is unconstrained, and no attribute
    /// on the property can see which. Applying the web page rule to both made this form
    /// unsubmittable for a JSON torrent, and clearing the field to get past it destroyed the pattern.
    /// </remarks>
    public IEnumerable<ValidationResult> Validate(ValidationContext validationContext) =>
        TorrentSourceRules.GetValidationResults(
            SourceKind,
            MagnetRegexPattern,
            IsWebPageSource ? null : JsonValueFormat);

    private bool AreControlsDisabled => IsBusy || _currentTorrent is null;

    private protected override string BusyMessage =>
        _operation switch
        {
            Operation.Load => "Loading torrent...",
            Operation.Update => "Updating torrent...",
            Operation.Refresh => "Refreshing torrent...",
            Operation.DeleteRecord => "Deleting torrent record...",
            Operation.DeleteTransmission => "Deleting torrent from Transmission...",
            Operation.DeleteData => "Deleting torrent data...",
            _ => "Processing..."
        };

    protected override async Task OnInitializedAsync() => await GetTorrentAsync();

    protected override async Task OnParametersSetAsync() => await GetTorrentAsync();

    private string OperationFailure => _operation switch
    {
        Operation.Load => "Failed to load torrent",
        Operation.Update => "Failed to update torrent",
        Operation.Refresh => "Failed to refresh torrent",
        Operation.DeleteRecord => "Failed to delete torrent record",
        Operation.DeleteTransmission => "Failed to delete torrent from Transmission",
        Operation.DeleteData => "Failed to delete torrent data",
        _ => "An error occurred"
    };

    private protected override string GetGenericErrorMessage(HttpRequestException exception) =>
        $"{OperationFailure}: '{exception.Message}'.";

    /// <remarks>
    /// The outcomes this page acts on - a torrent that is gone, or one another client changed - are
    /// answered where they are handled, so anything reaching here is a refusal it can only report.
    /// </remarks>
    private protected override string GetProblemDetailsMessage(
        ApiProblemDetails? problemDetails,
        HttpStatusCode? statusCode) =>
        $"{OperationFailure}: '{base.GetProblemDetailsMessage(problemDetails, statusCode)}'.";

    private async Task GetTorrentAsync()
    {
        if (IsBusy)
            return;

        _operation = Operation.Load;

        var result = await CallNetworkService(
            (Client, Id),
            static args => args.Client.GetTorrentByIdAsync(args.Id));

        FillTorrentData(result.Value);

        if (result.Status is ApiResultStatus.Success)
            Message = string.Empty;
        else if (result.Status is ApiResultStatus.NotFound)
            Message = "Torrent not found.";
    }

    private async Task UpdateTorrentAsync()
    {
        if (IsBusy)
            return;

        _operation = Operation.Update;

        DownloadDir = DownloadDir.Trim();
        MagnetRegexPattern = MagnetRegexPattern.Trim();
        JsonValueFormat = JsonValueFormat.Trim();
        Cron = Cron.Trim();

        var request = new UpdateTorrentByIdRequest
        {
            DownloadDir = DownloadDir,
            MagnetRegexPattern = MagnetRegexPattern,
            JsonValueFormat = IsWebPageSource ? null : JsonValueFormat,
            Cron = Cron
        };

        var current = _currentTorrent!;
        var outcome = await CallNetworkService(
            (Client, current.Id, current.Version, request),
            static args => args.Client.UpdateTorrentByIdAsync(args.Id, args.Version, args.request));

        switch (outcome.Status)
        {
            case ApiResultStatus.Success:
                FillTorrentData(current.ApplyPatch(request));
                Message = "Torrent updated.";
                break;
            case ApiResultStatus.Conflict:
                await GetTorrentAsync();
                Message = "Torrent was modified by another client. Reloaded the latest data; review and retry.";
                break;
            case ApiResultStatus.NotFound:
                FillTorrentData(null);
                Message = "Torrent no longer exists; it may have been deleted by another client.";
                break;
            default:
                break;
        }
    }

    private async Task RefreshTorrentAsync()
    {
        if (IsBusy)
            return;

        _operation = Operation.Refresh;

        var result = await CallNetworkService(
            (Client, Id),
            static args => args.Client.RefreshTorrentByIdAsync(args.Id));

        if (result.Status is not ApiResultStatus.Success)
            return;

        FillTorrentData(result.Value!.TorrentDto);
        Message = string.IsNullOrEmpty(result.Value.Message)
            ? $"Torrent refreshed. Transmission result: {result.Value.TransmissionResult}."
            : $"Torrent refreshed. Transmission result: {result.Value.TransmissionResult}. {result.Value.Message}";
    }

    private Task DeleteLocalTorrentAsync() =>
        DeleteTorrentAsync(DeleteTorrentByIdType.Local);

    private Task DeleteLocalAndTransmissionTorrentAsync() =>
        DeleteTorrentAsync(DeleteTorrentByIdType.LocalAndTransmission);

    private Task DeleteTorrentAndDataAsync() =>
        DeleteTorrentAsync(DeleteTorrentByIdType.LocalAndTransmissionAndData);

    private async Task DeleteTorrentAsync(DeleteTorrentByIdType deleteType)
    {
        if (IsBusy)
            return;

        _operation = deleteType switch
        {
            DeleteTorrentByIdType.Local => Operation.DeleteRecord,
            DeleteTorrentByIdType.LocalAndTransmission => Operation.DeleteTransmission,
            DeleteTorrentByIdType.LocalAndTransmissionAndData => Operation.DeleteData,
            _ => Operation.DeleteRecord
        };

        var current = _currentTorrent!;
        var outcome = await CallNetworkService(
            (Client, current.Id, current.Version, deleteType),
            static args => args.Client.DeleteTorrentByIdAsync(args.Id, args.Version, args.deleteType));

        switch (outcome.Status)
        {
            case ApiResultStatus.Success:
                FillTorrentData(null);
                Message = "Torrent deleted.";
                break;
            case ApiResultStatus.Conflict:
                await GetTorrentAsync();
                Message = outcome.CurrentVersion is { } cv
                    ? $"Torrent was modified by another client (now at version {cv}). Reloaded the latest data; please review and retry."
                    : "Torrent was modified by another client. Reloaded the latest data; please review and retry.";
                break;
            case ApiResultStatus.NotFound:
                FillTorrentData(null);
                Message = "Torrent was already deleted.";
                break;
            default:
                break;
        }
    }

    private void FillTorrentData(TorrentDto? torrentDto)
    {
        _currentTorrent = torrentDto;
        DownloadDir = torrentDto?.DownloadDir ?? string.Empty;
        MagnetRegexPattern = torrentDto?.MagnetRegexPattern ?? string.Empty;
        JsonValueFormat = torrentDto is { SourceKind: TorrentSourceKind.JsonPointer }
            ? torrentDto.JsonValueFormat ?? string.Empty
            : string.Empty;
        Cron = torrentDto?.Cron ?? string.Empty;
    }
}
